# ResumeIQ Environment Variables
# Copy this file to .env and fill in your values

# Flask settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# AI API Keys (optional - app works with NLP fallback if not provided)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Set to true to use AI API for enhanced analysis
USE_AI_API=false

# Database (defaults to SQLite)
DATABASE_URL=sqlite:///resumeiq.db

# Email / SMTP Settings (for Password Reset)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@resumeiq.ai
